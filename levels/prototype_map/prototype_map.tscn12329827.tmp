[sub_resource type="GDScript" id="GDScript_fg2v6"]
script/source = "extends MeshInstance3D
class_name GridVisualizer

@export var cell_size: float = 2.0
@export var grid_width: int = 10  # 10 tiles wide * 2m = 20 meters
@export var grid_depth: int = 10  # 10 tiles deep * 2m = 20 meters
@export var grid_color: Color = Color(0.0, 1.0, 1.0, 0.5) # Glowing semi-transparent cyan

func _ready() -> void:
	generate_grid_lines()

func generate_grid_lines() -> void:
	# 1. Create a dynamic, procedural mesh container
	var imm_mesh = ImmediateMesh.new()
	self.mesh = imm_mesh
	
	# 2. Setup an unshaded material so the grid glows regardless of world lighting
	var material = StandardMaterial3D.new()
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.albedo_color = grid_color
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	
	# 3. Begin drawing lines
	imm_mesh.surface_begin(Mesh.PRIMITIVE_LINES, material)
	
	# Calculate the outer edges so the grid centers perfectly around (0,0,0)
	var half_width = (grid_width * cell_size) / 2.0
	var half_depth = (grid_depth * cell_size) / 2.0
	var y_offset = 0.01 # Sit a tiny fraction above the floor to avoid visual flickering (Z-fighting)
	
	# Draw Horizontal Lines (along the X axis)
	for i in range(grid_depth + 1):
		var z = (i * cell_size) - half_depth
		imm_mesh.surface_add_vertex(Vector3(-half_width, y_offset, z))
		imm_mesh.surface_add_vertex(Vector3(half_width, y_offset, z))
		
	# Draw Vertical Lines (along the Z axis)
	for i in range(grid_width + 1):
		var x = (i * cell_size) - half_width
		imm_mesh.surface_add_vertex(Vector3(x, y_offset, -half_depth))
		imm_mesh.surface_add_vertex(Vector3(x, y_offset, half_depth))
		
	# 4. Commit the lines to the GPU
	imm_mesh.surface_end()

# This handles the visibility toggle when you press a key!
func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"ui_focus_next\"): # This is bound to the 'TAB' key by default in Godot
		visible = not visible
		print(\"Tactical Grid Visibility toggled: \", visible)
"

